# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# AI Features Toggle
AI_ENABLED=true

# Optional: AI Configuration
AI_DEFAULT_TEMPERATURE=0.7
AI_MAX_TOKENS=8192
AI_TIMEOUT=60

# Telegram (outbound notifications — same bot token as Hermes gateway)
# Copy values from ~/.hermes/.env (TELEGRAM_BOT_TOKEN and TELEGRAM_DEFAULT_CHAT_ID)
# Sulu only sends; inbound is still owned by Hermes.
TELEGRAM_BOT_TOKEN=1234567890:AAH-your-bot-token-from-botfather
TELEGRAM_DEFAULT_CHAT_ID=123456789