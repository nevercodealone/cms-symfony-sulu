<header class="relative bg-white z-40 border-b-2 border-green-900"
        {{ stimulus_controller('mobile-menu') }}
        itemscope itemtype="https://schema.org/SiteNavigationElement">

  {# ══ LOGO + CHIP NAV + HAMBURGER (single row on desktop) ══ #}
  <div class="bg-white px-4 py-3 flex items-center max-w-screen-xl mx-auto">
    <a href="{{ sulu_content_root_path() }}"
       aria-label="Zur Startseite – Never Code Alone"
       title="Link zur Startseite auf dem Logo"
       class="flex no-underline flex-shrink-0"
       itemprop="url">
       <img aria-hidden="true" class="h-16 md:h-20 w-auto" src="/img/logo.png" alt="Logo Never Code Alone" itemprop="name">
    </a>

    {# Chip navigation — hidden on mobile, centered within its section on desktop #}
    <nav aria-label="Schnellnavigation nach Bereich" class="hidden xl:flex flex-1 justify-center items-center px-4">
      <ul role="list"
          class="flex justify-center gap-2 nav-chips-scroll overflow-x-auto">
        {% for item in navItems %}
          {% set url = sulu_content_path(item.url) %}
          <li class="flex-shrink-0" style="padding:0;margin:0">
            <a href="{{ url }}"
               title="{{ item.title }}"
               class="border-2 border-green-900 text-xs font-black tracking-wide uppercase px-3 py-1.5 whitespace-nowrap transition-colors duration-150 inline-block no-underline
                 {{ app.request.uri starts with url ? 'bg-green-900 text-white' : 'bg-white text-green-900 hover:bg-green-900 hover:text-white' }}">
               {{ item.title }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>

    {# Hamburger button — visible only below desktop breakpoint, pushes chip nav center via flex-shrink-0 #}
    <div class="xl:hidden flex-shrink-0 ml-auto">
      <button
        type="button"
        {{ stimulus_action('mobile-menu', 'open') }}
        {{ stimulus_target('mobile-menu', 'toggle') }}
        aria-expanded="false"
        aria-controls="nca-mobile-menu"
        aria-label="Hauptmenü öffnen"
        class="flex items-center gap-2 text-xs font-black tracking-widest uppercase px-3 py-2 border-2 bg-green-900 text-white border-green-900 transition-colors duration-200">

        <span aria-hidden="true" class="w-4 h-4 relative flex flex-col justify-center gap-1 flex-shrink-0">
          <span class="hamburger__bar block h-0.5 w-4 bg-current"></span>
          <span class="hamburger__bar block h-0.5 w-4 bg-current"></span>
          <span class="hamburger__bar block h-0.5 w-4 bg-current"></span>
        </span>

        <span class="nav-toggle__label--menu">MENU</span>
        <span class="nav-toggle__label--close">CLOSE</span>
      </button>
    </div>
  </div>

  {# ══ MAIN MENU OVERLAY (native dialog) ══ #}
  <dialog id="nca-mobile-menu"
          closedby="any"
          {{ stimulus_target('mobile-menu', 'dialog') }}>
    <nav aria-label="Hauptnavigation"
         class="bg-green-900 text-white overflow-y-auto w-full h-full"
         style="scrollbar-width: none;">

      {# Action row: close + call #}
      <div class="border-b border-white/20 px-4 py-3 flex items-center justify-between gap-3">
        <a href="tel:+4917624747727"
           {{ stimulus_action('mobile-menu', 'closeOnLink') }}
           aria-label="Roland Golla direkt anrufen"
           class="inline-flex items-center gap-2 bg-white text-green-900 text-sm font-bold tracking-widest uppercase px-4 py-2.5 border border-white hover:bg-green-900 hover:text-white hover:border-white transition-colors duration-200 no-underline">
          <svg class="w-4 h-4 flex-shrink-0" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
          </svg>
          ROLAND ANRUFEN
        </a>
        <button
          type="button"
          {{ stimulus_action('mobile-menu', 'close') }}
          aria-label="Menü schließen"
          class="flex items-center gap-2 text-xs font-bold tracking-widest uppercase px-3 py-2 border border-white bg-green-900 text-white hover:bg-white hover:text-green-900 transition-colors duration-200 flex-shrink-0">

          <span aria-hidden="true" class="w-4 h-4 relative flex flex-col justify-center gap-1">
            <span class="hamburger__bar block h-0.5 w-4 bg-current"></span>
            <span class="hamburger__bar block h-0.5 w-4 bg-current"></span>
            <span class="hamburger__bar block h-0.5 w-4 bg-current"></span>
          </span>

          <span>CLOSE</span>
        </button>
      </div>

      {# NAV LIST #}
      <ul role="list">

        {% for item in navItems %}
          {% if item.children|length > 0 %}
            {# Accordion item with children #}
            <li class="border-b border-white/20" style="margin:0;padding:0">
              <details>
                <summary class="w-full flex items-center justify-between px-4 py-3 text-left text-white hover:bg-white hover:text-green-900 transition-colors duration-150">
                  <span class="text-base font-semibold tracking-wide uppercase">
                    {{ item.title }}
                  </span>
                  <svg aria-hidden="true"
                    class="nav-chevron w-4 h-4 flex-shrink-0 transition-colors duration-150"
                    fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                    <path stroke-linecap="square" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
                  </svg>
                </summary>
                <ul id="submenu-{{ loop.index }}" role="list" class="bg-white">
                  {# Link to overview page first #}
                  <li style="margin:0;padding:0">
                    <a href="{{ sulu_content_path(item.url) }}"
                       {{ stimulus_action('mobile-menu', 'closeOnLink') }}
                       class="flex items-center gap-3 px-4 py-2.5 border-b border-gray-200 hover:bg-green-900 hover:text-white transition-colors duration-150 group no-underline">
                      <span aria-hidden="true" class="text-green-700 font-bold text-xs group-hover:text-white">→</span>
                      <span class="text-sm font-medium uppercase tracking-wide text-green-900 group-hover:text-white">Übersicht {{ item.title }}</span>
                    </a>
                  </li>
                  {% for child in item.children %}
                    <li style="margin:0;padding:0">
                      <a href="{{ sulu_content_path(child.url) }}"
                         {{ stimulus_action('mobile-menu', 'closeOnLink') }}
                         class="flex items-center gap-3 px-4 py-2.5 {{ not loop.last ? 'border-b border-gray-200' }} hover:bg-green-900 hover:text-white transition-colors duration-150 group no-underline">
                        <span aria-hidden="true" class="text-green-700 font-bold text-xs group-hover:text-white">→</span>
                        <span class="text-sm font-medium uppercase tracking-wide text-green-900 group-hover:text-white">{{ child.title }}</span>
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              </details>
            </li>
          {% else %}
            {# Simple link without children #}
            <li class="border-b border-white/20" style="margin:0;padding:0">
              <a href="{{ sulu_content_path(item.url) }}"
                 {{ stimulus_action('mobile-menu', 'closeOnLink') }}
                 class="flex items-center px-4 py-3 hover:bg-white transition-colors duration-150 group no-underline">
                <span class="text-base font-semibold tracking-wide uppercase text-white group-hover:text-green-900 transition-colors duration-150">
                  {{ item.title }}
                </span>
              </a>
            </li>
          {% endif %}
        {% endfor %}

      </ul>
    </nav>
  </dialog>

</header>
<!-- end navigation.html.twig -->
