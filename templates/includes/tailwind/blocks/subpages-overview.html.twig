<!-- subpages-overview.html.twig -->
{% if content.items is defined and content.items is not empty %}
{% set initialLimit = 6 %}
{% set total = content.items|length %}
{% set loadMore = not content.disableLoading|default(false) and total > initialLimit %}
<div class="py-12 sm:py-16"
     {% if loadMore %}data-controller="load-more" data-load-more-step-value="6"{% endif %}>
  <div class="grid grid-cols-1 gap-y-10 gap-x-6 sm:-mx-6 sm:grid-cols-2 lg:grid-cols-3" data-load-more-target="grid">
    {% for item in content.items %}
      {% set imageSrc = '' %}
      {% set imageAlt = item.title %}
      {% if item.excerptImages is defined and item.excerptImages is not empty and item.excerptImages[0] is not empty %}
        {% set imageSrc = item.excerptImages[0].formats['content-full.webp']|default('') %}
      {% endif %}
      {% set description = '' %}
      {% if item.excerptDescription is defined and item.excerptDescription is not empty %}
        {% set description = item.excerptDescription %}
      {% elseif item.seoDescription is defined and item.seoDescription is not empty %}
        {% set description = item.seoDescription %}
      {% endif %}
      {% if loadMore and loop.index > initialLimit %}<div hidden>{% endif %}
      {% include 'includes/tailwind/includes/article-card.html.twig' with {
        'url': sulu_content_path(item.url),
        'title': item.title,
        'image_src': imageSrc,
        'image_alt': imageAlt,
        'description': description
      } only %}
      {% if loadMore and loop.index > initialLimit %}</div>{% endif %}
    {% endfor %}
  </div>
  {% if loadMore %}
    <div class="mt-10 flex justify-center" data-load-more-target="actions">
      <button type="button"
              data-action="click->load-more#reveal"
              class="inline-flex items-center gap-2 rounded-md bg-green-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-green-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-700">
        Mehr zeigen <span data-load-more-target="count">{{ initialLimit }}/{{ total }}</span>
      </button>
    </div>
    <noscript>
      <style>
        [data-controller~="load-more"] [data-load-more-target="grid"] > [hidden] { display: block; }
        [data-controller~="load-more"] [data-load-more-target="actions"] { display: none !important; }
      </style>
    </noscript>
  {% endif %}
</div>
{% endif %}
<!-- end subpages-overview.html.twig -->
