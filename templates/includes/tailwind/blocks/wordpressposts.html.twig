<!-- wordpressPosts.html.twig -->
{% set wordpressPosts = wordpressPosts() %}
{% if wordpressPosts is defined and wordpressPosts is not empty %}
<aside aria-label="Blog Posts" class="py-4 bg-white lg:py-8 antialiased">
  <div class="mx-auto max-w-screen-xl">
    {% if content.headline is defined and content.headline is not empty %}
      <h2 class="mb-4 text-2xl sm:text-3xl lg:text-4xl tracking-tight font-bold text-gray-900">
        {{ content.headline }}
      </h2>
    {% endif %}
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {% for wordpressPost in wordpressPosts %}
      {% set imageSrc = '' %}
      {% set imageAlt = '' %}
      {% if wordpressPost['_embedded']['wp:featuredmedia'][0]['source_url'] is defined %}
        {% set featureMedia = wordpressPost['_embedded']['wp:featuredmedia'][0] %}
        {% set imageSrc = featureMedia['source_url'] %}
        {% set imageAlt = featureMedia['alt_text'] %}
      {% endif %}
      {% include 'includes/tailwind/includes/article-card.html.twig' with {
        'url': wordpressPost.link,
        'title': wordpressPost['title']['rendered'],
        'image_src': imageSrc,
        'image_alt': imageAlt,
        'description': wordpressPost['excerpt']['rendered'],
        'target': '_blank'
      } only %}
      {% endfor %}
    </div>
  </div>
</aside>
{% endif %}
<!-- end wordpressPosts.html.twig -->
