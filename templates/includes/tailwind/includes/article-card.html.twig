<!-- article-card.html.twig -->
<article>
  <a href="{{ url }}"{% if target is defined and target %} target="{{ target }}"{% endif %}
     class="group relative block bg-white rounded-lg p-6 transition-all duration-300 hover:scale-105 hover:shadow-xl focus:scale-105 focus:shadow-xl border border-transparent hover:border-green-700/20 focus:outline-none focus:ring-2 focus:ring-green-700 focus:ring-offset-2 no-underline hover:no-underline">
    {% if image_src is defined and image_src %}
      <div class="overflow-hidden rounded-lg mb-5">
        <img src="{{ image_src }}"
             class="w-full max-w-full"
             alt="{{ image_alt|default('') }}"
             loading="lazy">
      </div>
    {% endif %}
    <span class="mb-2 block text-xl font-bold leading-tight text-gray-900 dark:text-white group-hover:text-green-800 transition-colors">
      {{ title }}
    </span>
    {% if description is defined and description is not empty %}
      <div class="text-sm text-gray-800">
        {{ description|raw }}
      </div>
    {% endif %}
  </a>
</article>
<!-- end article-card.html.twig -->
