<!-- article-card.html.twig -->
<article>
  <a href="{{ url }}"{% if target is defined and target %} target="{{ target }}"{% endif %}>
    {% if image_src is defined and image_src %}
      <img src="{{ image_src }}"
           class="mb-5 w-full max-w-full rounded-lg"
           alt="{{ image_alt|default('') }}"
           loading="lazy">
    {% endif %}
  </a>
  <p class="mb-2 text-xl font-bold leading-tight text-gray-900 dark:text-white">
    <a href="{{ url }}"{% if target is defined and target %} target="{{ target }}"{% endif %}>{{ title }}</a>
  </p>
  {% if description is defined and description is not empty %}
    <p class="flex items-center space-x-4">
      <span class="text-sm text-gray-800">
        {{ description|raw }}
      </span>
    </p>
  {% endif %}
</article>
<!-- end article-card.html.twig -->
