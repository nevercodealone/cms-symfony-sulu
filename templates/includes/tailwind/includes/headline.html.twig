{% set htmlId = content.headline|nca_slugify %}
{% if headlineNumber|default(null) %}
  {% set htmlId = '%02d'|format(headlineNumber) ~ '-' ~ htmlId %}
{% endif %}

{% if isFirstHeadline %}
  <h1 class="mb-4 text-2xl sm:text-3xl lg:text-4xl tracking-tight font-bold text-gray-900" id="{{ htmlId }}">
    {{ content.headline }}
  </h1>
{% else %}
  <h2 class="mb-4 text-2xl sm:text-3xl lg:text-4xl tracking-tight font-bold text-gray-900" id="{{ htmlId }}">
    {{ content.headline }}
  </h2>
{% endif %}
<!-- end headline.html.twig -->
