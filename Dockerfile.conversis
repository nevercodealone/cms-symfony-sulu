# syntax=docker/dockerfile:1
FROM composer AS composer

WORKDIR /var/www/html

COPY composer.* /var/www/html/

FROM composer AS composer-live

# Application docker
# The Sulu AI bundles come from the private repo sulu.repo.packagist.com. The token is passed as a
# BuildKit secret (docker build --secret id=sulu_composer_token,...) and only lives in this RUN step:
# it is not written to any image layer.
RUN --mount=type=secret,id=sulu_composer_token \
    if [ -s /run/secrets/sulu_composer_token ]; then \
        export COMPOSER_AUTH="{\"http-basic\":{\"sulu.repo.packagist.com\":{\"username\":\"token\",\"password\":\"$(cat /run/secrets/sulu_composer_token)\"}}}"; \
    fi; \
    composer install --apcu-autoloader -o --no-scripts --ignore-platform-reqs --no-dev

FROM composer AS composer-dev

RUN --mount=type=secret,id=sulu_composer_token \
    if [ -s /run/secrets/sulu_composer_token ]; then \
        export COMPOSER_AUTH="{\"http-basic\":{\"sulu.repo.packagist.com\":{\"username\":\"token\",\"password\":\"$(cat /run/secrets/sulu_composer_token)\"}}}"; \
    fi; \
    composer install --apcu-autoloader -o --no-scripts --ignore-platform-reqs

# Build actual image
FROM php:8.5.9-apache AS webserver

WORKDIR /var/www/html

# install packages
RUN apt-get update && apt-get install -y \
        openssl \
        git \
        msmtp \
        gettext-base \
        unzip \
        libzip-dev \
        libicu-dev \
        libmagickwand-dev \
        mariadb-client

# install PHP extensions (opcache is already enabled in the official php image)
RUN docker-php-ext-configure intl && docker-php-ext-install \
        intl \
        pdo \
        pdo_mysql \
        zip

COPY --from=mlocati/php-extension-installer /usr/bin/install-php-extensions /usr/local/bin/
RUN install-php-extensions imagick redis apcu

# apache config
RUN /usr/sbin/a2enmod rewrite && /usr/sbin/a2enmod headers && /usr/sbin/a2enmod expires
COPY ./deploy/config/www.conf /etc/apache2/sites-available/000-default.conf
COPY ./deploy/config/mpm_prefork.conf /etc/apache2/mods-available/mpm_prefork.conf

# php config
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
ADD ./deploy/config/php.ini /usr/local/etc/php/conf.d/custom.ini

# MSMTP config (template, rendered at runtime by entrypoint.sh)
ADD ./deploy/config/msmtprc.template /etc/msmtprc.template

ADD ./deploy/entrypoint.sh /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/usr/sbin/apachectl", "-DFOREGROUND"]

FROM webserver AS webserver-live

# copy needed files from build containers
COPY --from=composer-live /var/www/html/vendor/ /var/www/html/vendor/
RUN touch /var/www/html/.env
COPY --chown=www-data:www-data . /var/www/html/
RUN mkdir -p /var/www/html/var && chown www-data:www-data /var/www/html/var && chmod 775 /var/www/html/var && rm -rf /var/www/html/var/cache/*

FROM webserver AS webserver-dev

# copy needed files from build containers
COPY --from=composer-dev /var/www/html/vendor/ /var/www/html/vendor/
RUN touch /var/www/html/.env
COPY --chown=www-data:www-data . /var/www/html/
RUN mkdir -p /var/www/html/var && chown www-data:www-data /var/www/html/var && chmod 775 /var/www/html/var && rm -rf /var/www/html/var/cache/*